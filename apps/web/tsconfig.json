{
  "extends": "@repo/typescript-config/tanstack.json",
  "compilerOptions": {
    "strictNullChecks": true,
    "paths": {
      "@/*": ["./src/*"],
      "@repo/*": ["../../packages/*"],
      "@repo/ui/*": ["../../packages/ui/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": ["node_modules"]
}
