# Authentication
BETTER_AUTH_SECRET=tanstack-starter-local-dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# Optional social authentication
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database
DATABASE_URL=

# Disable local verification unless you also configure SMTP or EMAIL_API_KEY.
EMAIL_VERIFICATION_ENABLED=false

# Email - SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Email - API Provider (e.g., Resend)
EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com
